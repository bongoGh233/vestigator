# Vestigator environment configuration
# Copy to .env and adjust. Only the values you actually use are required.

# HTTP port the single server listens on
PORT=4001

# In production the built client is served from the same server.
# Set NODE_ENV=production on your host (enables secure cookies + static serving).
# For a local "one server" test over plain HTTP, use SERVE_STATIC=1 instead of
# NODE_ENV=production so session cookies work without TLS.
NODE_ENV=production
# SERVE_STATIC=1

# Public base URL used for links in emails (e.g. https://vestigator.example.com)
APP_URL=https://vestigator.example.com

# Force Secure cookies + HSTS even outside production (needed behind TLS proxies)
COOKIE_SECURE=1

# Directory for the SQLite database (defaults to ./server/data)
# DATA_DIR=/var/lib/vestigator

# Auto-mark a booking as arrived when the person is within this many metres
# of the destination
ARRIVE_THRESHOLD_M=80

# How long a profile track code stays valid, in minutes
TRACK_CODE_TTL_MIN=10

# OSRM routing server for routes and ETAs
# OSRM_SERVER=https://router.project-osrm.org

# SMTP for password resets / notifications. If SMTP_HOST is unset, emails are
# logged to the console instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=no-reply@example.com
# SMTP_PASS=changeme
# MAIL_FROM=Vestigator <no-reply@example.com>
